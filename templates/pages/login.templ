package pages

import "github.com/ashish9868/rapidbackend/templates/layouts"
import "github.com/ashish9868/rapidbackend/templates/components/forms"
import "github.com/ashish9868/rapidbackend/dto"

templ LoginForm(login *dto.LoginForm, errors map[string]any) {
	@forms.Form("superadmin_login_form", "/login", "post") {
		@forms.Input(forms.InputBaseProps{Type: "email", Name: "email", Label: "Email", LabelIcon: "mail", Placeholder: "Enter Name", Value: login.Email, Error: forms.PullMapValue(errors, "email")})
		@forms.Input(forms.InputBaseProps{Type: "password", Name: "password", Label: "Password", LabelIcon: "key", Placeholder: "Enter Name", Error: forms.PullMapValue(errors, "password")})
		@forms.Button(forms.ButtonBaseProps{Label: "Login", EndIcon: "arrow-right", Type: "submit"})
		@layouts.RunJs()
	}
}

templ LoginPage() {
	@layouts.PublicLayout() {
		@LoginForm(&dto.LoginForm{}, map[string]any{})
	}
}
